# Check that CHANGELOG.md changed nothing below its [Unreleased] section since this branch forked from <base> (default:
# origin/main). Entries belong in [Unreleased]; released sections are history.

set -e -o pipefail

cd "$(dirname "$(dirname "$0")")"
BASE="$(git merge-base HEAD "${1:-origin/main}")"

git cat-file blob "${BASE}:CHANGELOG.md" | sed -n '/^## \[[0-9]/,$p' | diff -u --label "${BASE}" --label "working tree" - <(sed -n '/^## \[[0-9]/,$p' < CHANGELOG.md)
