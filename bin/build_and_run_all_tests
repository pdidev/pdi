set -xe



# Setup our directories

SRCDIR="${PWD}"

if [ -z "${TEST_DIR}" ]
then
	cd "$(mktemp -d pdibuild.XXXXX)"
	TEST_DIR="${PWD}"
else
	cd "${TEST_DIR}"
	TEST_DIR="${PWD}"
fi

cd "${SRCDIR}"
cd "$(dirname "$0")/.."
SRCDIR="${PWD}"

cd "${TEST_DIR}"


# Gather options

MAKEFLAGS="${MAKEFLAGS:--j}"
EXCLUDED_PDI_TESTS=""

if [[ -n "${PDI_PLUGIN_PATH}" ]]
then
	CMAKE_FLAGS="-DINSTALL_PDIPLUGINDIR=${PDI_PLUGIN_PATH} ${CMAKE_FLAGS}"
fi

if [[ "x${PDI_LIBS}" = "xprovided" ]]
then
	CMAKE_FLAGS="-DUSE_DEFAULT=SYSTEM ${CMAKE_FLAGS}"
else
	CMAKE_FLAGS="-DUSE_DEFAULT=EMBEDDED ${CMAKE_FLAGS}"
fi



# Various workarounds

if [[ "x${PDI_SYSTEM}" =~ ^x(ubuntu|debian) && "x${PDI_MPI}" = "xmpich" ]]
then
	# Workaround: mpi4py in debuntu is packaged for openmpi only
	EXCLUDED_PDI_TESTS="${EXCLUDED_PDI_TESTS:+$EXCLUDED_PDI_TESTS|}PDI_example_trace_P|PDI_example_decl_hdf5_P"
fi

if [[ "x${PDI_SYSTEM}" =~ ^x(ubuntu|debian) && "x${PDI_LIBS}" = "xprovided" ]]
then
	# Workaround: parallel NetCDF detection broken in debuntu (and absent in mpich case)
	CMAKE_FLAGS="-DBUILD_NETCDF_PARALLEL=OFF ${CMAKE_FLAGS}"
fi


if [[ "x${PDI_SYSTEM}" =~ ^x(ubuntu|debian) ]] && dpkg-query -W 'libspdlog-dev' > /dev/null
then
	# Workaround: spdlog mismatch between the vendored version and dependency of doxygen
	#             https://github.com/pdidev/test_env/issues/30
	#             (see  https://github.com/pdidev/test_env/actions/runs/27519792247/job/81335351522)
	CMAKE_FLAGS="-DUSE_spdlog=SYSTEM ${CMAKE_FLAGS}"
fi



# Configure, build and test one project in the build directory tests_<name>, with a junit report of the same name, which CI collects as tests_*.xml.
# <launcher> prefixes each command: the runs that use the installation set it to the pdirun of that installation.
# The configure flags come before CMAKE_FLAGS, so that the user can override them.
# usage: conf_build_and_run <launcher> <name> <source directory> [cmake configure flags...]
conf_build_and_run() {
	local LAUNCHER="$1"
	local NAME="tests_$2"
	local SOURCE="$3"
	shift 3
	${LAUNCHER} cmake "$@" ${CMAKE_FLAGS} -S "${SOURCE}" -B "${NAME}"
	${LAUNCHER} cmake --build "${NAME}" -- ${MAKEFLAGS}
	${LAUNCHER} ctest --output-on-failure --timeout 90 ${CTEST_FLAGS} ${CTEST_DIR:+--output-junit "${CTEST_DIR}/${NAME}.xml"} ${EXCLUDED_PDI_TESTS:+-E $EXCLUDED_PDI_TESTS} --test-dir "${NAME}"
}



# And now for the actual tests

printf "\n\n\n\e[1;36m *** Configure, build, test & install the whole pdi distribution\e[m\n\n"

mkdir -p install/include install/lib # Workaround for https://github.com/pdidev/pdi/issues/644
conf_build_and_run "" distribution "${SRCDIR}" --install-prefix "${PWD}/install" -DDIST_PROFILE=Devel
cmake --install tests_distribution


# The runs that check the installation

printf "\n\n\n\e[1;36m *** Unit test the generated CMake configuration\e[m\n\n"
./install/bin/pdirun cmake -S "${SRCDIR}/tests/cmake_tests/multiple_find" -B tests_cmake_multiple_find

printf "\n\n\n\e[1;36m *** Run the API tests against the installed pdi\e[m\n\n"
conf_build_and_run ./install/bin/pdirun api_installed "${SRCDIR}/tests/api_tests"

printf "\n\n\n\e[1;36m *** Run the examples against the installed pdi\e[m\n\n"
# The example expects no plugin unless told otherwise: enable those the distribution builds by default.
conf_build_and_run ./install/bin/pdirun example_installed "${SRCDIR}/example" \
	-DBUILD_DECL_HDF5_PLUGIN=ON -DBUILD_DECL_NETCDF_PLUGIN=ON -DBUILD_FORTRAN=ON -DBUILD_HDF5_PARALLEL=ON -DBUILD_MPI_PLUGIN=ON \
	-DBUILD_NETCDF_PARALLEL=ON -DBUILD_PYCALL_PLUGIN=ON -DBUILD_PYTHON=ON -DBUILD_SERIALIZE_PLUGIN=ON -DBUILD_SET_VALUE_PLUGIN=ON \
	-DBUILD_TIMER_PLUGIN=ON -DBUILD_TRACE_PLUGIN=ON -DBUILD_USER_CODE_PLUGIN=ON


# The runs that use no installation

printf "\n\n\n\e[1;36m *** Run the examples with SubdirMock PDI\e[m\n\n"
conf_build_and_run "" example_subdirmock "${SRCDIR}/example" -DEXAMPLE_MOCK_PDI=ON

printf "\n\n\n\e[1;36m *** Run the API tests with SubdirMock PDI\e[m\n\n"
conf_build_and_run "" api_subdirmock "${SRCDIR}/tests/api_tests" -DAPI_TESTS_PDI=MOCK

if [[ "x${PDI_LIBS}" = "xprovided" ]]
then
	printf "\n\n\n\e[1;36m *** Run the examples with MockFind PDI\e[m\n\n"
	conf_build_and_run "" example_mockfind "${SRCDIR}/example" -DPDI_ROOT="${SRCDIR}/mock_pdi"

	printf "\n\n\n\e[1;36m *** Run the API tests with MockFind PDI\e[m\n\n"
	conf_build_and_run "" api_mockfind "${SRCDIR}/tests/api_tests" -DAPI_TESTS_PDI=FIND -DPDI_ROOT="${SRCDIR}/mock_pdi"
fi
