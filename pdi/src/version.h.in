/// PDI major revision number
#define PDI_VERSION_MAJOR @PDI_VERSION_MAJOR@
/// PDI minor revision number
#define PDI_VERSION_MINOR @PDI_VERSION_MINOR@
/// PDI patch revision number
#define PDI_VERSION_PATCH @PDI_VERSION_PATCH@
/// PDI version modificator as a string: e.g. "-alpha0", "-git", "-rc5", etc.
#cmakedefine PDI_VERSION_MODIF "@PDI_VERSION_MODIF@"

/** Computes a version of PDI as an int, comparable with PDI_VERSION and with what PDI_version() provides
 *
 * The result is usable in a preprocessor `#if` as well as in code.
 * Bits 24 to 30 hold the major revision number, bits 16 to 23 the minor one and bits 8 to 15 the patch one.
 */
#define PDI_COMPUTE_VERSION(MAJOR, MINOR, PATCH) (((0ul + (MAJOR)) << 24) | ((0ul + (MINOR)) << 16) | ((0ul + (PATCH)) << 8))

/// The version of the PDI headers as an int, as PDI_COMPUTE_VERSION computes it
#define PDI_VERSION PDI_COMPUTE_VERSION(PDI_VERSION_MAJOR, PDI_VERSION_MINOR, PDI_VERSION_PATCH)
