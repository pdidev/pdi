# The "SubdirMock" cmake that \ref SubdirMock tells a user to write.
# The snippet below is what the documentation shows, `<path/to>' included; the
# CMakeLists.txt beside this file replaces that placeholder with the real
# location of `mock_pdi' before including the result, so that the very lines
# the page displays are the ones that get configured.

#! [subdirmock]
if("${DISABLE_PDI}")
	add_subdirectory(<path/to>/mock_pdi mock_pdi)
else()
	find_package(PDI REQUIRED)
endif()
#! [subdirmock]

#! [subdirmock_without_paraconf]
if("${DISABLE_PDI}")
	set(PDI_MOCK_PARACONF_TARGET TRUE)
	add_subdirectory(<path/to>/mock_pdi mock_pdi)
else()
	find_package(paraconf REQUIRED)
	find_package(PDI REQUIRED)
endif()
#! [subdirmock_without_paraconf]
