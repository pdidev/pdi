# Checks that the download, build and install commands shown in the source
# installation documentation really work for the latest release.
#
# The version below is substituted by cmake from the content of the
# `RELEASED_VERSION' file, so that this script names the latest release without
# anybody having to keep a copy of the version up to date; `bin/release' only
# updates `RELEASED_VERSION'.
# Both this test and the documentation use the *configured* file from the binary
# directory, so the two can never disagree.
#
# The commands are run for real, in a throw-away directory: `HOME' is pointed at
# it so that the `${HOME}/.local/' prefix the page shows installs there rather
# than in the home of whoever runs the test suite.

set -e -o pipefail

WORKDIR="$(mktemp -d)"
trap 'rm -rf "${WORKDIR}"' EXIT
cd "${WORKDIR}"

# the page installs to `${HOME}/.local/', keep that out of the real home
export HOME="${WORKDIR}"

#! [download]
curl -LO https://github.com/pdidev/pdi/archive/refs/tags/@PDI_RELEASED_VERSION@.tar.gz
tar -xzf @PDI_RELEASED_VERSION@.tar.gz
#! [download]

# the archive really holds the release the documentation names
test -d "pdi-@PDI_RELEASED_VERSION@"
test -f "pdi-@PDI_RELEASED_VERSION@/CMakeLists.txt"

#! [build]
mkdir pdi-@PDI_RELEASED_VERSION@/build
cd pdi-@PDI_RELEASED_VERSION@/build
cmake -DCMAKE_INSTALL_PREFIX="${HOME}/.local/" ..   # configuration
make install   # compilation and installation
#! [build]

# the commands really produced an installation a user can load
test -f "${HOME}/.local/bin/pdirun"
test -d "${HOME}/.local/include"
